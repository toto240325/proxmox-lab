# local.rules — proxmox-lab custom signatures
# SID range reserved for this lab: 1000000-1000099
# Purpose: ET Open has no generic TCP/UDP port-scan preprocessor (unlike
# Snort sfPortscan). These rules close that gap for the lab detection loop.
# Tuned for a single-host lab (HOME_NET 10.10.10.0/24) — thresholds would be
# far too sensitive for a production network of any real size.

# --- TCP scan techniques (by packet flags) ---
alert tcp any any -> $HOME_NET any (msg:"LAB SCAN Nmap TCP SYN scan detected"; flags:S,12; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LAB SCAN Nmap NULL scan detected"; flags:0; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000002; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LAB SCAN Nmap FIN scan detected"; flags:F,12; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000003; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LAB SCAN Nmap Xmas scan detected"; flags:FPU,12; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LAB SCAN Nmap ACK scan detected"; flags:A; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000005; rev:1;)

# --- UDP sweep ---
alert udp any any -> $HOME_NET any (msg:"LAB SCAN UDP port sweep detected"; threshold: type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000006; rev:1;)

# --- Nmap service/version detection fingerprint (NSE default HTTP UA) ---
alert http any any -> $HOME_NET any (msg:"LAB SCAN Nmap Scripting Engine HTTP User-Agent"; flow:established,to_server; http.user_agent; content:"Nmap Scripting Engine"; classtype:attempted-recon; sid:1000007; rev:1;)

# --- Generic many-distinct-ports-from-one-source (slow/stealth scan catch-all) ---
alert tcp any any -> $HOME_NET any (msg:"LAB SCAN Possible slow port scan (high connection attempt rate)"; flags:S,12; threshold: type threshold, track by_src, count 50, seconds 120; classtype:network-scan; sid:1000008; rev:1;)
